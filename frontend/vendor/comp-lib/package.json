{
  "name": "@luvn/component-library",
  "version": "0.1.0",
  "private": true,
  "description": "Swiss 1 component library (React) for the SOTE AI Hackathon 2026. Tokens and components mirror the Figma Design-Library.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./fonts.css": "./src/styles/fonts.css"
  },
  "scripts": {
    "tokens": "node scripts/figma-to-dtcg.mjs && node scripts/build-tokens.mjs && node scripts/verify-tokens.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@figma/code-connect": "^2.0.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.4",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.2",
    "style-dictionary": "^5.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@fontsource/host-grotesk": "^5.3.0",
    "lucide-react": "^1.53.0"
  }
}
