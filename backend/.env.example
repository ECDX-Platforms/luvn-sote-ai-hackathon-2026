# Copy to backend/.env for the live model path. Never commit .env; `.gitignore` covers it and
# `.dockerignore` keeps it out of the image.
#
# None of this is needed for the gate. `scripts/check.sh` runs offline, and the one test that needs a
# live model (`tests/test_foundry_live.py`) self-skips without `LUNA_FOUNDRY_BASE` and
# `LUNA_FOUNDRY_KEY`. Note that pytest does not read this file: export the variables, or run pytest
# with `--env-file`, if you want that test to run.
#
# There are two independent model paths, and they degrade separately:
#
#   * Narration (Foundry): `LUNA_FOUNDRY_*`. Without a key the briefing renders with no prose panel.
#   * Decision-1 selection and the per-sentence verifier: same key, `LUVN_DECISION_DEPLOYMENT`.
#     Without a key both stages fail closed and the deterministic briefing still renders.

# --- Narration: the Foundry project route and model ---------------------------------------------
# The project-scoped route, ending in /openai/v1, or the bare account host. `_foundry_host` in
# app/decision_providers.py strips /api/... and /openai from either form.
LUNA_FOUNDRY_BASE=https://<account>.services.ai.azure.com/api/projects/<project>/openai/v1
# The project endpoint (no /openai/v1). Used for the versioned prompt agent's token probe.
LUNA_FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# The account key, from Key Vault in a deployment. Both model paths use this one key.
LUNA_FOUNDRY_KEY=<key>
# Required whenever a key is set: app/llm.py raises without it rather than guessing a model.
LUNA_FOUNDRY_MODEL=gpt-6.1-sol
# The versioned prompt agent. With these set the narration path is `agent_reference`; without them it
# falls back to direct chat-completions, and the Picture reports which branch actually ran.
LUNA_FOUNDRY_AGENT_NAME=luvn-narration
LUNA_FOUNDRY_AGENT_VERSION=8
LUNA_FOUNDRY_TIMEOUT=120
LUNA_FOUNDRY_MAX_RETRIES=1

# --- Knowledge retrieval (embeddings over Azure SQL VECTOR) -----------------------------------
# The assistant's search_knowledge tool and `python -m app.load_knowledge` embed with this deployment
# on the LUNA_FOUNDRY_BASE/KEY endpoint. Empty or unset = off: retrieval falls back to the committed
# snapshots' token overlap, so nothing here is needed to run or test. The dimension count must equal
# the knowledge_chunks column, VECTOR(1536); Azure SQL allows at most 1,998.
# LUVN_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# LUVN_EMBEDDING_DIMENSIONS=1536
# LUVN_EMBEDDING_TIMEOUT=10
# LUVN_EMBEDDING_BASE=   # default: LUNA_FOUNDRY_BASE without its /api/projects/<name> segment (the account-level /openai/v1 route serves embeddings)

# --- Decision-1 --------------------------------------------------------------------------------
# The Foundry deployment name of Microsoft-Decision-1. Defaults to "Decision-1" when unset.
LUVN_DECISION_DEPLOYMENT=Decision-1
# How many typed calls are in flight at once, and how often a failed one is retried. An unbounded
# fan-out loses calls to HTTP 429 and silently thins a briefing; see decision_model.py.
LUVN_DECISION_CONCURRENCY=8
LUVN_DECISION_RETRIES=2

# --- Corpus source: choose one ----------------------------------------------------------------
# 1. Azure SQL (the deployed shape). All three are needed together; with none of them set the app
#    serves the curated fixtures under data/experimental/bound-personas instead.
# LUVN_SQL_SERVER=<server>.database.windows.net
# LUVN_SQL_DATABASE=luvn
# LUVN_SQL_CLIENT_ID=<managed identity client id>   # the app's db_datareader-only identity
# LUVN_SQL_ACCESS_TOKEN=<token>                     # overrides the managed identity; local use only
# 2. An imported delivery directory (see backend/scripts/reconcile_delivery.py).
# LUVN_DELIVERY_DIR=<dir>

# --- Hosting behaviour, all optional ----------------------------------------------------------
# LUVN_HOSTED=1                        # marks the hosted shape (affects the technical disclosure)
# LUVN_STATIC_DIR=/app/frontend/dist   # serve the built SPA from here; unset serves the API only
# LUVN_BUILD_REVISION=<commit sha>     # reported by /health/* and /api/diagnostics
# LUVN_CATALOGUE_TTL_SECONDS=30        # operator-catalogue cache; a failed refresh keeps the last one

# --- Proposal feedback storage ----------------------------------------------------------------
# jsonl (default, a local file) or blob (managed identity against LUVN_STORAGE_ACCOUNT_URL).
# LUVN_STORE_BACKEND=blob
# LUVN_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net/
# LUVN_STORAGE_CLIENT_ID=<managed identity client id>
# LUVN_FEEDBACK_CONTAINER=feedback
# LUVN_FEEDBACK_PATH=<prefix inside the container>

# --- Telemetry, optional ----------------------------------------------------------------------
# Scrub-whitelisted stage events only; see app/telemetry.py for exactly which fields are emitted.
# APPLICATIONINSIGHTS_CONNECTION_STRING=<connection string>

# --- The loader job only (not the app) --------------------------------------------------------
# LUVN_CORPUS_CONTAINER=delivery
# LUVN_CORPUS_PREFIX=corpus/current
